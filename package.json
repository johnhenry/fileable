{
  "name": "fileable",
  "version": "2.0.0",
  "description": "Declaratively describe filesystem artifacts -- files, directories, and deletions -- using JSX as the composition language.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnhenry/fileable.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.19"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/src/jsx-runtime.d.ts",
      "default": "./dist/src/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/src/jsx-dev-runtime.d.ts",
      "default": "./dist/src/jsx-dev-runtime.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test scripts/run-tests.mjs",
    "coverage": "node --test --experimental-test-coverage scripts/run-tests.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "jsx",
    "filesystem",
    "static-site",
    "codegen",
    "scaffolding"
  ],
  "author": "John Henry",
  "dependencies": {
    "fflate": "^0.8.3",
    "glob": "^13.0.6",
    "marked": "^18.0.13",
    "node-html-parser": "^9.0.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "typescript": "^7.0.2"
  }
}
